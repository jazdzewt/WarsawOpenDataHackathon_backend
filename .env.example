APP_NAME=FastAPI Template
APP_VERSION=0.1.0
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=sqlite:///./app.db
# Wymagane. Wygeneruj losowy klucz (min. 32 znaki), np.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=60
